  "animation": {
    "rest": "Capture each joint rest quaternion once; multiply procedural local rotations onto it.",
    "jaw": "Local X angle 0 at rest; -0.40 rad for speech; recommended -0.45 rad limit.",
    "blink": "eye.L and eye.R local Y scale 1 open, 0.08 closed; pupil child follows.",
    "gaze": "Worm: pupil.L/R local X and Z rotations (+/-0.25 rad). Beady slug/mass: rotate eye.L/R; pupil joints have no separate pupil geometry.",
    "body": "body.0..body.6 independent children of root, ordered front to tail. Small local Z turns and local X scales deform locomotion.",
    "appendages": "tendril.L/R on slug and mass; local X/Z rotation offsets about +/-0.25 rad.",
    "attachment": "head for face/held prop; tendril.L/R for appendages. Parent to the joint and apply attachment_tip_offsets_joint_local; no separate tip nodes."
  },
